rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player. Any signed-in player can read (for the leaderboard),
    // but only the owner can write their own document.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['name', 'photo', 'progress', 'points', 'solved', 'streak', 'lastDay', 'updated'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 40
                            && request.resource.data.points is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
